generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String
}

model Restaurant {
  id             String  @id @default(cuid())
  name           String
  logoUrl        String?
  bannerUrl      String?
  whatsappNumber String
  primaryColor   String  @default("#FF6321")
  accentColor    String  @default("#000000")
  address        String?
}

model Category {
  id       String    @id @default(cuid())
  name     String
  order    Int       @default(0)
  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Float
  imageUrl    String?
  categoryId  String
  available   Boolean     @default(true)
  addOns      String?
  orderItems  OrderItem[]
  category    Category    @relation(fields: [categoryId], references: [id])
}

model Order {
  id            String      @id @default(cuid())
  customerName  String
  customerPhone String
  address       String
  paymentMethod String
  observations  String?
  total         Float
  status        String      @default("novo")
  createdAt     DateTime    @default(now())
  items         OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  product   Product @relation(fields: [productId], references: [id])
  order     Order   @relation(fields: [orderId], references: [id])
}
